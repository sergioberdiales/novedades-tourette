---
const base = import.meta.env.BASE_URL;
const links = [
  { label: "Inicio", href: "https://touretteasturias.org/" },
  { label: "¿Quiénes Somos?", href: "https://touretteasturias.org/quienes-somos-2/" },
  { label: "Acerca del Síndrome de Tourette", href: "https://touretteasturias.org/acerca-del-sindrome-de-tourette/" },
  { label: "Blog", href: "https://touretteasturias.org/blog/" },
  { label: "Noticias Tourette", href: base },
  { label: "Hazte socio de APASTTA", href: "https://touretteasturias.org/hazte-socio-de-apastta/" },
  { label: "Publicaciones APASTTA", href: "https://touretteasturias.org/publicaciones-apastta/" },
];
---
{links.map(({ label, href }) => <a href={href} aria-current={href === base ? "location" : undefined}>{label}</a>)}
