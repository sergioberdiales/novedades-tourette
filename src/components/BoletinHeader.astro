---
import EnlacesApastta from "./EnlacesApastta.astro";

const base = import.meta.env.BASE_URL;
---

<header class="boletin-header">
  <div class="association-band">
    <a class="association-logo" href="https://touretteasturias.org/">
      <img src={base + "apastta-blanco.svg"} width="186" height="56" alt="APASTTA, web de la asociación" />
    </a>
    <details class="compact-menu">
      <summary aria-label="Menú de APASTTA"><span class="bars" aria-hidden="true"></span></summary>
      <nav aria-label="Secciones de APASTTA">
        <EnlacesApastta />
      </nav>
    </details>
  </div>
  <div class="editorial-row">
    <a class="boletin-title" href={base}>Novedades sobre el Síndrome de Tourette</a>
    <nav class="wide-menu" aria-label="Secciones de APASTTA">
      <EnlacesApastta />
    </nav>
  </div>
</header>

<style>
  .boletin-header { background: var(--panel); border-bottom: 1px solid var(--line); }
  .association-band { position: relative; display: grid; place-items: center; padding: 10px 0; background: #0675c4; }
  .association-logo, .association-logo img { display: block; }
  .association-logo:focus-visible, summary:focus-visible { outline: 2px solid white; outline-offset: 2px; }
  .editorial-row { max-width: var(--layout-width); margin-inline: auto; padding: .5rem var(--gutter) .25rem; box-sizing: content-box; text-align: center; }
  .boletin-title { font: 600 1.3125rem/1.3 Georgia, serif; color: var(--ink-strong); text-decoration: none; }
  .wide-menu { display: flex; justify-content: center; align-items: center; gap: clamp(.75rem, 1.3vw, 1.3rem); margin-top: .2rem; }
  nav :global(a) { display: block; padding: .5rem 0; color: var(--muted-strong); font-size: .9375rem; text-decoration: none; }
  nav :global(a[aria-current]) { color: #005c99; font-weight: 700; }
  nav :global(a:hover), .boletin-title:hover { color: var(--accent); text-decoration: underline; }
  .compact-menu { display: none; }
  @media (max-width: 64.99rem) {
    .association-logo img { width: 156px; height: auto; }
    .editorial-row { padding: .4rem var(--gutter); }
    .boletin-title { display: inline-block; font-size: 1.125rem; text-wrap: balance; }
    .wide-menu { display: none; }
    .compact-menu { display: block; position: absolute; left: 1rem; top: 50%; transform: translateY(-50%); z-index: 5; }
    summary { display: grid; width: 44px; height: 44px; place-items: center; list-style: none; color: white; border-radius: 4px; cursor: pointer; }
    summary::-webkit-details-marker { display: none; }
    summary:hover, details[open] summary { background: #055d9c; }
    .bars { width: 20px; height: 15px; border-block: 2px solid; background: linear-gradient(currentColor,currentColor) center / 100% 2px no-repeat; }
    .compact-menu nav { position: absolute; top: calc(100% + .5rem); left: 0; width: min(16rem, calc(100vw - 2rem)); background: white; padding: .4rem; border: 1px solid var(--line); border-radius: .4rem; box-shadow: var(--shadow); }
    .compact-menu nav :global(a) { padding: .65rem .85rem; }
  }
</style>

<script>
  const menu = document.querySelector<HTMLDetailsElement>(".compact-menu");
  if (menu) {
    document.addEventListener("click", (event) => {
      if (event.target instanceof Element && (!menu.contains(event.target) || event.target.closest("a"))) menu.open = false;
    });
    menu.addEventListener("keydown", (event) => {
      if (event.key === "Escape") {
        menu.open = false;
        menu.querySelector("summary")?.focus();
      }
    });
  }
</script>
